PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h
ASSET_TOKEN_TTL_SECONDS=120
NODE_ENV=development

# Leave unset normally — the /api/setup/owner route 404s when this is
# unset, so it's off by default. Only set this temporarily (on the actual
# deploy, e.g. Railway variables) to bootstrap the one owner account, then
# unset it again. See README.md "Promoting the owner account" section.
# SETUP_SECRET=

# Leave both unset for local dev — verification codes are logged to the
# console instead of emailed (see src/lib/email.js). Set both to send real
# emails via Resend (resend.com, free tier: 3,000/month, 100/day).
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=onboarding@resend.dev
